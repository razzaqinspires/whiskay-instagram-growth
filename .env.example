# WHISKAY private experimental runtime. Real secrets stay only in local .env.
# Used only for the explicit first Instagram login; remove after session creation.
IG_PASSWORD=

# Optional verified-referral backend only. Not related to Instagram growth or billing.
REFERRAL_SERVICE_TOKEN=
REFERRAL_WEBHOOK_SECRET=

# Local QA adapter only; these do not enable Instagram actions.
# NODE_ENV=development
# MAX_BATCH_SIZE=1000

# Optional Academi.cx document review integration. Keep this key private.
# The external provider may apply its own usage limits or charges.
ACADEMICX_KEY=

# Optional system FFmpeg/FFprobe paths for local video upscaling. Leave blank to auto-detect.
FFMPEG_PATH=
FFPROBE_PATH=

# Optional: enable only when this WhatsApp session is a real Business account with catalog data you control.
WHISKAY_WHATSAPP_BUSINESS_CATALOG_ENABLED=false
WHISKAY_BUSINESS_OWNER_JID=
WHISKAY_RICH_HTML_TRUSTED_DOMAIN=

# YouTube Music public WEB_REMIX client overrides (optional; not a private API credential).
YOUTUBE_MUSIC_API_KEY=
YOUTUBE_MUSIC_CLIENT_VERSION=
YT_DLP_PATH=

# Optional HTTPS image for the WhatsApp Channel preview shown by .menu.
# The default bundled image is a WHISKAY-designed thumbnail, not a verified channel avatar.
WHISKAY_CHANNEL_THUMBNAIL_URL=
