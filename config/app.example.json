{
  "app": {
    "logLevel": "info"
  },
  "whatsapp": {
    "pairingNumber": "",
    "ownerNumber": "",
    "sessionDir": "./session/self",
    "syncFullHistory": false
  },
  "commands": {
    "mode": "self",
    "runtimeModeFile": "./data/runtime-mode.json",
    "prefixes": [
      "!",
      "."
    ],
    "allowGroups": true,
    "maxMessageChars": 3000,
    "maxCommandArgs": 24,
    "unknownCommandNotificationsFile": "./data/unknown-command-notifications.json"
  },
  "plugins": {
    "directory": "./src/plugins",
    "hotReload": true,
    "maxFileBytes": 262144,
    "maxCommandsPerPlugin": 100
  },
  "antiSpam": {
    "enabled": true,
    "windowMs": 10000,
    "maxHits": 5,
    "cooldownMs": 1500,
    "commandsPerMinute": 20,
    "duplicateTtlMs": 60000,
    "warningCooldownMs": 30000,
    "maxConcurrent": 2
  },
  "instagram": {
    "username": "",
    "sessionFile": "./auth_ig/instagrapi-session.json",
    "statsFile": "./data/instagram-stats.json",
    "guardFile": "./data/instagram-safety.json",
    "pythonBin": "./.venv-instagram/bin/python",
    "platformApi": {
      "enabled": false,
      "loginMethod": "instagram_login",
      "baseUrl": "https://graph.instagram.com",
      "apiVersion": "",
      "endpoints": {
        "me": "/me",
        "media": "/me/media",
        "insights": "/me/insights"
      },
      "permissions": [
        "instagram_business_basic",
        "instagram_business_manage_insights"
      ],
      "tokenEnv": "INSTAGRAM_GRAPH_ACCESS_TOKEN",
      "timeoutMs": 15000
    },
    "targeting": {
      "mode": "manual",
      "manualUsernames": [],
      "candidateDirectory": "./data/instagram-approved-creators.json",
      "automatic": {
        "enabled": false,
        "maxCandidates": 25,
        "niches": [],
        "locations": [
          "Indonesia"
        ],
        "minFollowers": 100,
        "maxFollowers": 100000,
        "minEngagementRatePct": 0
      },
      "requireOwnerApproval": true,
      "allowedActions": [
        "review",
        "campaign_link",
        "collaboration_invite"
      ]
    }
  },
  "growth": {
    "databaseFile": "./data/instagram-growth.json"
  },
  "ownerCode": {
    "enabled": true,
    "timeoutMs": 15000,
    "maxCodeChars": 8000,
    "maxOutputBytes": 16000,
    "workDir": "./data/owner-runtime",
    "pythonBin": "python3",
    "goBin": "go",
    "shellBin": "/bin/bash",
    "auditFile": "./data/owner-code-audit.json"
  },
  "identity": {
    "lidMapFile": "./data/lid-map.json"
  },
  "referral": {
    "enabled": false,
    "claim": {
      "endpoint": "https://api-staging.example.test/v1/referrals/claims",
      "allowedHosts": [
        "api-staging.example.test"
      ],
      "serviceTokenEnv": "REFERRAL_SERVICE_TOKEN",
      "timeoutMs": 15000,
      "delayMs": 1000,
      "maxAttempts": 1
    },
    "webhook": {
      "enabled": false,
      "host": "127.0.0.1",
      "port": 8787,
      "path": "/webhooks/referral/verified",
      "secretEnv": "REFERRAL_WEBHOOK_SECRET",
      "autoProcess": false
    }
  },
  "academix": {
    "enabled": true,
    "apiKeyEnv": "ACADEMICX_KEY",
    "timeoutMs": 30000,
    "maxFileBytes": 52428800,
    "maxTextChars": 2500,
    "inboxDir": "./data/academic-inputs"
  },
  "trafficSafety": {
    "stateFile": "./data/whatsapp-traffic-safety.json",
    "queueFile": "./data/whatsapp-outbound-queue.json",
    "cooldownEnabled": true,
    "perCommandMs": 1800,
    "notifyCooldownOnce": true,
    "antiSpamEnabled": true,
    "burstWindowMs": 10000,
    "burstLimit": 5,
    "warningThreshold": 3,
    "banThreshold": 5,
    "warningWindowMs": 3600000,
    "banDurationMs": 900000,
    "transportEnabled": true,
    "minIntervalMs": 1200,
    "maxQueueSize": 1000,
    "queueEnabled": true,
    "auditRetention": 5000
  }
}
